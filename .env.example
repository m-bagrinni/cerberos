# ===== Django =====
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-please-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_DEBUG=1

# ===== PostgreSQL =====
POSTGRES_DB=cerber
POSTGRES_USER=cerber
POSTGRES_PASSWORD=cerber
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Redis / Celery =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== SNMP =====
SNMP_DEFAULT_TIMEOUT=2
SNMP_DEFAULT_RETRIES=1
SNMP_MAX_CONCURRENCY=200

# ===== Telegram (заполним позже) =====
TELEGRAM_BOT_TOKEN=

# ===== MIB =====
MIB_DIR=/app/mibs