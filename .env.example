# ===== Django =====
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-please-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_DEBUG=1
# prod: адреса с схемой через запятую (https://cerber.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== PostgreSQL =====
POSTGRES_DB=cerber
POSTGRES_USER=cerber
POSTGRES_PASSWORD=cerber
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Redis / Celery =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== SNMP =====
SNMP_DEFAULT_TIMEOUT=2
SNMP_DEFAULT_RETRIES=1
SNMP_MAX_CONCURRENCY=200

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=change-me
CERBER_WEBAPP_URL=http://localhost:8888/local/stations/

# ===== MIB =====
MIB_DIR=/app/mibs
# --- Настройки Active Directory (DC) ---
AD_SERVER=
AD_USER=
AD_PASSWORD=
AD_BASE_DN=
AD_USE_SSL=True
# PEM корневого CA домена — проверка сертификата LDAPS
AD_CA_CERT_FILE=

# --- SSH доступ к Linux DC (Samba) ---
DC_SSH_USER=
DC_SSH_PASSWORD=
DC_SSH_PORT=22

# ===== ops (доступ к Docker, ops/agent.py) =====
# Обязателен: без него страница «Службы» и детектор штормов не работают.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_TOKEN=change-me
OPS_URL=http://ops:9100

# ===== Docker =====
# uid/gid процессов в контейнерах и gid группы docker хоста (getent group docker)
CUID=1000
CGID=1000
DOCKER_GID=138
