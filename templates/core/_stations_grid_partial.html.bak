<div class="device-grid device-grid--stations" id="stationsGrid">
    {% for c in cards %}
    {% with st=c.station %}
    <div class="device-card device-card--station" data-slug="{{ st.slug }}">
        <div class="device-card__header">
            <span class="device-card__name">{{ st.name }}</span>
            <button class="device-card__edit" type="button" title="Редактировать"
                    onclick="event.stopPropagation(); openStationEdit('{{ st.slug }}', '{{ st.name|escapejs }}');">
                <i class="bi bi-pencil"></i>
            </button>
        </div>

        <div class="device-card__meta">
            <span class="device-card__ne-addr">{{ st.slug }}</span>
            <span class="device-card__ne-ip">x={{ st.x|floatformat:0 }}, y={{ st.y|floatformat:0 }}</span>
        </div>

        <div class="station-card__section">
            <div class="station-card__section-title">Мультиплексоры</div>
            {% for sn in st.nes.all %}
                <div class="station-eq">
                    <span class="device-card__status device-card__status--{{ sn.ne.status }}">●</span>
                    <span class="station-eq__name">{{ sn.ne.display_name }}</span>
                    <span class="station-eq__meta">NE-{{ sn.ne.ne_id }}</span>
                </div>
            {% empty %}
                <div class="station-eq station-eq--empty">—</div>
            {% endfor %}
        </div>

        <div class="station-card__section">
            <div class="station-card__section-title">Коммутаторы</div>
            {% for sd in st.devices.all %}
                <div class="station-eq">
                    <span class="device-card__status device-card__status--{{ sd.device.status }}">●</span>
                    <span class="station-eq__name">{{ sd.device.name }}</span>
                    <span class="station-eq__meta">{{ sd.device.ip }}</span>
                </div>
            {% empty %}
                <div class="station-eq station-eq--empty">—</div>
            {% endfor %}
        </div>

        <div class="station-card__links">
            <span class="station-card__links-count">
                <i class="bi bi-link-45deg"></i> {{ c.links_count }}
            </span>
            <button class="btn-mini" type="button"
                    onclick="event.stopPropagation(); openLinkAddForStation('{{ st.slug }}');">
                + линия
            </button>
        </div>
    </div>
    {% endwith %}
    {% empty %}
    <div class="device-grid__empty">Станций пока нет. Нажмите «Добавить станцию».</div>
    {% endfor %}
</div>
